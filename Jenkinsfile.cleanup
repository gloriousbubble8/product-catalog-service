pipeline {
    agent any
    stages {
        stage('Helm Cleanup'){
            steps {
                withCredentials(
                    [
                        string(
                            credentialsId: 'kubernetes-dev-token',
                            variable: 'K8S_TOKEN'
                        )
                    ]
                ){
                    sh '''
                        set +x

                        helm uninstall catalogue-dev \
                          --namespace dev \
                          --kube-apiserver=https://kubernetes.docker.internal:6443 \
                          --kube-ca-file=/var/jenkins_home/docker-desktop-ca.crt \
                          --kube-token="$K8S_TOKEN"
                    '''
                }
            }
        }
    }
}